# Quetie_mbg Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Twitch Bot Configuration
# ============================================

# Bot username (create a Twitch bot account first)
TWITCH_BOT_USERNAME=miss_brain_glitch_bot

# Channel to connect to (your main streaming channel)
TWITCH_TARGET_CHANNEL=miss_brain_glitch

# OAuth token for the bot account
# Get this from: https://twitchapps.com/tokengen/
# Scopes needed: chat:read:messages, chat:edit
TWITCH_OAUTH_TOKEN=oauth:your_bot_token_here

# Twitch Client ID (optional, for API calls in future)
TWITCH_CLIENT_ID=your_client_id_here

# Twitch Client Secret (required for token refresh/API workflows)
TWITCH_CLIENT_SECRET=your_client_secret_here

# Optional raw access/refresh tokens. If TWITCH_OAUTH_TOKEN is empty,
# the app auto-builds oauth:<TWITCH_ACCESS_TOKEN> for IRC login.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# ============================================
# Database Configuration
# ============================================

# SQLite (development - default)
DATABASE_URL=sqlite:///./quetie.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/quetie_db

# ============================================
# Web Server Configuration
# ============================================

# Web server host (0.0.0.0 for all interfaces, 127.0.0.1 for local only)
WEB_HOST=0.0.0.0

# Web server port
# Render sets PORT automatically; locally this defaults to 8000
WEB_PORT=8000

# Number of worker processes
WEB_WORKERS=1

# ============================================
# Security Configuration
# ============================================

# JWT secret key (MUST be changed in production!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time in hours
JWT_EXPIRATION_HOURS=24

# Admin credentials (for initial login)
ADMIN_USERNAME=admin
# Leave empty to use default password "admin123" (MUST be changed on first login!)
# Generate password hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# ============================================
# Application Configuration
# ============================================

# Environment: development or production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Playback reliability tuning
PLAYBACK_START_TIMEOUT_SECONDS=12
PLAYING_STALE_AFTER_SECONDS=21600

# ============================================
# Render Deployment Configuration (if using Render)
# ============================================

# PORT is automatically set by Render
# PORT=10000

# ============================================
# Notes
# ============================================
# 1. Get Twitch OAuth token: https://twitchapps.com/tokengen/
# 2. Create a Twitch bot account first
# 3. Add the bot account as a moderator to your channel
# 4. Change all secrets in production!
# 5. For Render: use environment variables in Render dashboard, not in .env file
# 6. Never commit a real .env file to GitHub
